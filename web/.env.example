# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# Go API used by the live dashboard status card
NEXT_PUBLIC_API_URL=http://localhost:8080

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Keep false for the local preview so the sample dashboard is reachable.
# Set true once Google OAuth is configured to protect /dashboard.
AUTH_REQUIRED=false
