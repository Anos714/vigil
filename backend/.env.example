# Vigil API + worker
VIGIL_ADDR=:8080
VIGIL_VERSION=0.2.0
VIGIL_LOG_LEVEL=info

# Optional for the API: without these it runs in scaffold mode.
# Required for the worker: DATABASE_URL.
DATABASE_URL=postgres://vigil:vigil@localhost:5433/vigil?sslmode=disable
REDIS_URL=redis://localhost:6380/0

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Standalone probe worker
VIGIL_WORKER_HEALTH_ADDR=:8081
VIGIL_WORKER_CONCURRENCY=4
VIGIL_WORKER_TICK=2s
VIGIL_WORKER_USER_AGENT=VigilProbe/0.1 (+self-hosted)

# Alert delivery. Keep disabled until Brevo credentials are supplied.
ALERT_EMAIL_ENABLED=false
BREVO_API_KEY=
BREVO_API_URL=https://api.brevo.com/v3/smtp/email
ALERT_FROM_EMAIL=
ALERT_FROM_NAME=Vigil
ALERT_REPLY_TO=
ALERT_TO_EMAIL=
VIGIL_APP_URL=http://localhost:3000

# Standalone alert notifier
VIGIL_NOTIFIER_HEALTH_ADDR=:8082
VIGIL_NOTIFIER_CONCURRENCY=4
